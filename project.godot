; Engine configuration file.
; Project Gauntlands — clean 2D reboot

config_version=5

[application]
config/name="Project Gauntlands"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=560
window/size/window_width_override=1280
window/size/window_height_override=1120
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

sword={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"button_index":0)]
}
bow={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75), Object(InputEventJoypadButton,"button_index":2)]
}
lock_target={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":76), Object(InputEventJoypadButton,"button_index":8)]
}
target_left={
"deadzone": 0.6,
"events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}
target_right={
"deadzone": 0.6,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":6)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"button_index":3)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
